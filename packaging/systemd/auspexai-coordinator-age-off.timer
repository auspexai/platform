[Unit]
Description=AuspexAI coordinator result-retention age-off (daily; a no-op when nothing is expired)
Documentation=https://github.com/auspexai/platform

[Timer]
# Retention horizons are day-granular (raw TTL ~30d, grace ~14d), so a daily off-peak
# sweep is ample. Persistent so a missed run (host asleep) fires on next boot.
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
