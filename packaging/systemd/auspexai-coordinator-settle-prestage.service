[Unit]
Description=AuspexAI coordinator — A11 reap the model_prestage table (abandon stale 'requested' directives so workers stop re-polling; delete dead-worker rows)
Documentation=https://github.com/auspexai/platform
After=network-online.target auspexai-coordinator.service
Wants=auspexai-coordinator.service

[Service]
Type=oneshot
User=jason
Group=jason
# Same state dir as the coordinator daemon (reads/writes the same control DB).
Environment=AUSPEXAI_STATE_DIR=/var/lib/auspexai-coordinator
EnvironmentFile=-/etc/auspexai/coordinator.env
ExecStart=/opt/auspexai-coordinator/bin/auspexai-coordinator settle-prestage --apply

# Hardening — same shape as auspexai-coordinator-settle-outcomes.service. WRITES
# (abandons stale rows + deletes dead-worker rows) into the coordinator state dir.
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/auspexai-coordinator
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
