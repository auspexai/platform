[Unit]
Description=AuspexAI coordinator — M-Results retention age-off sweep
Documentation=https://github.com/auspexai/platform
After=network-online.target

[Service]
Type=oneshot
User=jason
Group=jason
Environment=AUSPEXAI_STATE_DIR=/var/lib/auspexai-coordinator
# DRY-RUN by default in the CLI; --apply blanks expired payloads while
# preserving rows, signatures, hashes, and receipts. Hold-aware + audit-logged.
ExecStart=/opt/auspexai-coordinator/bin/auspexai-coordinator age-off --apply

# Hardening — mirrors auspexai-coordinator.service. Reads the binary from a
# read-only /opt; writes only under the state dir (control DB audit row +
# per-job payload blanking).
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/auspexai-coordinator
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
